<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>


<?import ni.junaxer.practicafx.components.CustomSeparator?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="ni.junaxer.practicafx.controllers.FormController"
      style="
      -fx-background-color: #FFFFFF;
      -fx-border-width: 1px;
      -fx-border-color: #AFAFAF;
      -fx-padding: 16px;
      -fx-spacing: 12px;"
      prefHeight="Infinity" prefWidth="Infinity" HBox.hgrow="ALWAYS">

    <CustomSeparator title="TableView (Datos)"/>

    <TableView fx:id="tbProductos" VBox.vgrow="ALWAYS" style="-fx-border-color: #e2e8f0; -fx-border-radius: 4px;">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="50" style="-fx-alignment: CENTER;"/>
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="180"/>
            <TableColumn fx:id="colCategoria" text="Categoría" prefWidth="120"/>
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="100" style="-fx-alignment: CENTER;"/>
            <TableColumn fx:id="colAcciones" text="Acciones" prefWidth="100" style="-fx-alignment: CENTER;"/>
        </columns>
        
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>

    </TableView>

</VBox>